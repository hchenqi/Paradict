{
  "manifest_version": 3,
  "name": "Paradict",
  "version": "0.1.0",
  "description": "Look up selected text across Paradict concepts.",
  "permissions": ["activeTab", "scripting"],
  "host_permissions": ["http://localhost:3000/*"],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Search Paradict"
  }
}
